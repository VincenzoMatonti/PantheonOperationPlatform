{
    "name": "Pantheon: Athena Dev Container",
    "dockerComposeFile": [
        "../../infra/.local/controls/compose.yml",
        "compose.dev.yml"
    ],
    "service": "athena-dev",
    "workspaceFolder": "/workspace",
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp"
            ]
        }
    },
    "remoteUser": "root"
}