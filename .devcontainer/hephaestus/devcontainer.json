{
    "name": "Pantheon: Hephaestus Dev Container",
    "dockerComposeFile": [
        "../../infra/local/compose.yml",
        "../compose.dev.yml"
    ],
    "service": "hephaestus",
    "workspaceFolder": "/workspace",
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp"
            ]
        }
    },
    "remoteUser": "root"
}