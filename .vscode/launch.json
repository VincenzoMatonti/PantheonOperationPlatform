    "version": "0.2.0",
    "configurations": [
        {
            "name": "Hermes.Api",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/Hermes/Hermes.Api/bin/Debug/net10.0/Hermes.Api.dll",
